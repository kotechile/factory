{
  "version": "1.1.0",
  "enforced_from": "2026-10-20",
  "owner": "Jorge",
  "audience": "technical decision-makers, operators and engineers",
  "contract": {
    "lead": "First sentence states the conclusion or the number. No throat-clearing.",
    "scan": "Bold lead-ins on bullets; a reader should get the claim in under 5 seconds.",
    "strip": "No marketing adjectives, corporate jargon, or introductory pleasantries.",
    "proof": "Every claim carries a figure, a rule, or a named failure it prevents. No adjective substitutes for evidence.",
    "hook": "Copy must name the interactive asset and what the reader gets back from it."
  },
  "banned": [
    { "id": "delve", "pattern": "\\bdelve(s|d|ing)?\\b", "label": "delve" },
    { "id": "testament", "pattern": "\\btestament\\b", "label": "testament" },
    { "id": "tapestry", "pattern": "\\btapestry\\b", "label": "tapestry" },
    { "id": "landscape-jargon", "pattern": "\\b(the|competitive|regulatory|digital|tech|technology|ai|vendor|market)\\s+(\\w+\\s+)?landscape\\b", "label": "…landscape (business jargon)" },
    { "id": "landscape-of", "pattern": "\\blandscape of\\b", "label": "landscape of" },
    { "id": "beacon", "pattern": "\\bbeacon (of|for|in)\\b", "label": "beacon of/for" },
    { "id": "unleash", "pattern": "\\bunleash(es|ed|ing)?\\b", "label": "unleash" },
    { "id": "supercharge", "pattern": "\\bsupercharg(e|es|ed|ing)\\b", "label": "supercharge" },
    { "id": "harness-verb", "pattern": "\\bharness(es|ed|ing)?\\s+(the|your|our|its|this|these|that|data|power|insight|potential)\\b", "label": "harness (verb)" },
    { "id": "in-todays", "pattern": "\\bin today'?s\\b", "label": "in today's…" },
    { "id": "in-an-era", "pattern": "\\bin an era (of|where)\\b", "label": "in an era of…" },
    { "id": "no-secret", "pattern": "\\bit'?s no secret\\b", "label": "it's no secret" },
    { "id": "important-remember", "pattern": "\\bit'?s important to remember\\b", "label": "it's important to remember" },
    { "id": "furthermore", "pattern": "\\bfurthermore\\b", "label": "furthermore" },
    { "id": "moreover", "pattern": "\\bmoreover\\b", "label": "moreover" },
    { "id": "dive-deep", "pattern": "\\b(dive deep|deep dive|let'?s dive)\\b", "label": "dive deep" },
    { "id": "lets-explore", "pattern": "\\blet'?s explore\\b", "label": "let's explore" },
    { "id": "in-conclusion", "pattern": "\\bin conclusion\\b", "label": "in conclusion" },
    { "id": "in-summary", "pattern": "\\bin summary\\b", "label": "in summary" },
    { "id": "game-changing", "pattern": "\\bgame[- ]chang(er|ing)\\b", "label": "game-changing" },
    { "id": "cutting-edge", "pattern": "\\bcutting[- ]edge\\b", "label": "cutting-edge" },
    { "id": "revolutionary", "pattern": "\\brevolution(ary|ize|izing|ising)\\b", "label": "revolutionary" },
    { "id": "world-class", "pattern": "\\bworld[- ]class\\b", "label": "world-class" },
    { "id": "best-in-class", "pattern": "\\bbest[- ]in[- ]class\\b", "label": "best-in-class" },
    { "id": "next-gen", "pattern": "\\bnext[- ]gen(eration)?\\b", "label": "next-generation" },
    { "id": "state-of-the-art", "pattern": "\\bstate[- ]of[- ]the[- ]art\\b", "label": "state-of-the-art" },
    { "id": "one-stop", "pattern": "\\bone[- ]stop\\b", "label": "one-stop shop" },
    { "id": "guesswork", "pattern": "\\btakes? the guesswork out\\b", "label": "takes the guesswork out of" },
    { "id": "peace-of-mind", "pattern": "\\bpeace of mind\\b", "label": "peace of mind" },
    { "id": "data-driven-insights", "pattern": "\\bdata[- ]driven insights?\\b", "label": "data-driven insights" },
    { "id": "empowering", "pattern": "\\bempower(s|ed|ing)?\\b", "label": "empower / empowering" },
    { "id": "synergy", "pattern": "\\bsynerg(y|ies|istic)\\b", "label": "synergy" },
    { "id": "leverage-verb", "pattern": "\\bleverag(e|es|ed|ing)\\s+(the|your|our|its|this|these|data|insights|technology|ai)\\b", "label": "leverage (verb)" },
    { "id": "embark", "pattern": "\\bembark(s|ed|ing)?\\b", "label": "embark" },
    { "id": "plethora", "pattern": "\\b(a )?plethora of\\b", "label": "a plethora of" },
    { "id": "dream-home", "pattern": "\\bdream home\\b", "label": "dream home" },
    { "id": "sanctuary-oasis", "pattern": "\\bsanctuary oasis\\b", "label": "sanctuary oasis" },
    { "id": "forever-home", "pattern": "\\bforever home\\b", "label": "forever home" },
    { "id": "nest-egg", "pattern": "\\bnest egg\\b", "label": "nest egg" },
    { "id": "curb-appeal-magic", "pattern": "\\bcurb appeal magic\\b", "label": "curb appeal magic" },
    { "id": "when-it-comes-mid", "pattern": "\\bwhen it comes to (home|buying|selling|remodel|renovat|property)", "label": "when it comes to home…" },
    { "id": "important-keep-in-mind", "pattern": "\\bit (is|'s) important to (keep in mind|note) that\\b", "label": "it is important to keep in mind that" }
  ],
  "openers": [
    { "id": "welcome-to", "pattern": "^welcome to\\b", "label": "Welcome to…" },
    { "id": "were-excited", "pattern": "^(we'?re|we are) (excited|thrilled|proud|delighted)\\b", "label": "We're excited…" },
    { "id": "we-believe", "pattern": "^(we|our team) (believe|think|know)\\b", "label": "We believe…" },
    { "id": "at-company-we", "pattern": "^at [A-Z][\\w ]{1,30},? we\\b", "label": "At <Company>, we…" },
    { "id": "imagine", "pattern": "^(imagine|picture this)\\b", "label": "Imagine…" },
    { "id": "when-it-comes", "pattern": "^when it comes to\\b", "label": "When it comes to…" },
    { "id": "in-the-world", "pattern": "^in the world of\\b", "label": "In the world of…" },
    { "id": "lets-face", "pattern": "^let'?s face it\\b", "label": "Let's face it" },
    { "id": "our-mission", "pattern": "^(our|the) mission (is|at)\\b", "label": "Our mission is…" },
    { "id": "company-about-us", "pattern": "^(we help|we make|we build|we provide|we offer)\\b", "label": "We help/make/build…" }
  ],
  "adjectives": [
    { "id": "seamless", "pattern": "\\bseamless(ly)?\\b", "label": "seamless" },
    { "id": "robust", "pattern": "\\brobust(ly|ness)?\\b", "label": "robust" },
    { "id": "powerful", "pattern": "\\bpowerful\\b", "label": "powerful" },
    { "id": "innovative", "pattern": "\\binnovat(ive|ion)\\b", "label": "innovative" },
    { "id": "transformative", "pattern": "\\btransformative\\b", "label": "transformative" },
    { "id": "holistic", "pattern": "\\bholistic\\b", "label": "holistic" },
    { "id": "streamline", "pattern": "\\bstreamlin(e|es|ed|ing)\\b", "label": "streamline" },
    { "id": "elevate", "pattern": "\\belevat(e|es|ed|ing)\\b", "label": "elevate" },
    { "id": "unlock", "pattern": "\\bunlock(s|ed|ing)?\\b", "label": "unlock" },
    { "id": "effortless", "pattern": "\\beffortless(ly)?\\b", "label": "effortless" },
    { "id": "comprehensive", "pattern": "\\bcomprehensive\\b", "label": "comprehensive" },
    { "id": "solutions", "pattern": "\\b(end-to-end |complete |full )?solutions?\\b", "label": "solution(s)" }
  ],
  "preferred": [
    { "id": "pref-lead-magnet", "pattern": "\\blead[- ]magnet\\b", "from": "lead magnet", "to": "interactive asset" },
    { "id": "pref-ebook", "pattern": "\\b(e-?book|whitepaper)\\b", "from": "ebook / whitepaper", "to": "interactive asset" },
    { "id": "pref-calculator", "pattern": "\\b(roi calculator|cost calculator|savings calculator)\\b", "from": "ROI/savings calculator", "to": "net yield engine (positioning copy only — keep the search term in H1/URL/nav)" },
    { "id": "pref-backend", "pattern": "\\bbackend (automation|scripts?|plumbing)\\b", "from": "backend automation", "to": "agentic plumbing" },
    { "id": "pref-advanced", "pattern": "\\b(advanced|sophisticated) (features|tools?)\\b", "from": "advanced features", "to": "precision mechanics" }
  ],
  "exceptions": [
    "EmPOWER",
    "landscape (design|designer|architect|architecture|lighting|contractor|fabric|planting|improvement|plan|plans|supply|materials|maintenance)",
    "harness (file|config|configuration|suite|fixture|runner|test)",
    "test harness",
    "leverag(e|ed|ing) (ratio|ratios|buyout|buyouts|point|points|factor|factors|multiple)",
    "operating leverage",
    "financial leverage",
    "deleverag(e|ing)"
  ],
  "thresholds": {
    "max_sentence_words": 32,
    "max_first_sentence_words": 28,
    "max_adjective_hits_per_page": 3,
    "flesch_floor": 50,
    "flesch_enforced_by": "Editorial-Factory/scripts/check_accessibility.py scores article bodies; page copy is not scored (the front gate has no readability pass)"
  }
}
