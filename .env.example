# Supabase (Auth + DB) — never commit real values; set these in Coolify/runtime env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Payments + Webhooks)
# STRIPE_MODE selects which key pair the server sends: "test" = sandbox, "live" = production.
# The mode is decided by the KEY, never by the Stripe dashboard toggle — which is why both
# pairs stay configured and switching is a single env change (see src/lib/stripe/mode.ts).
# Keep BOTH pairs on the production app; set only the sandbox pair on a dev box.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
# Legacy single-slot names — superseded by the mode pairs above. Still read as a fallback when
# the mode-specific slot is empty (the secret key must still match STRIPE_MODE's prefix).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend (Transactional Email)
RESEND_API_KEY=

# Internal Editorial Gate (Access to editorial-factory.aichieve.net & /pressflow)
EDITORIAL_SECRET=factory_editorial_2026

# Customer service (/api/support) — OPTIONAL, ≥16 chars. Bearer token for the INTERNAL paths only:
# listing/filtering tickets and changing a ticket's status. Unset ⇒ those paths return an explicit 403.
# Anonymous callers never need it: filing a ticket (POST) and reading back ONE ticket by
# ticket_id + the email it was filed with (GET) work without it and are not affected by it.
SUPPORT_ADMIN_TOKEN=

# Public App Base URL
NEXT_PUBLIC_APP_URL=https://apps.giniloh.com

# ─── Post-Ship Launch Video ("brag" pipeline) ───────────────────────────────────────────────
# Read by scripts/launch-video/*.mjs (repo .env only — never from Supabase factory_config).
# Missing values are a HARD failure in those scripts; there are no fallback providers.

# ElevenLabs text-to-speech (voiceover). Get the key from elevenlabs.io → Profile → API keys.
ELEVENLABS_API_KEY=
# Pick a voice with: node scripts/launch-video/voices.mjs --list
ELEVENLABS_VOICE_ID=
# Optional overrides (defaults in src/lib/launch-video/elevenlabs.ts)
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# YouTube Data API v3 (owner's own channel). Mint the refresh token ONCE with:
#   node scripts/youtube-auth.mjs --url      # open the printed URL, approve, copy the code
#   node scripts/youtube-auth.mjs --code <code>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public — uploads default to private so a human approves before the world sees it
# (the alias YOUTUBE_PRIVACY is also accepted, and YOUTUBE_DEFAULT_TAGS for the tags below)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_TAGS=factory,deterministic,saas,tools
# optional: YouTube category id (28 = Science & Technology) and the made-for-kids declaration
YOUTUBE_CATEGORY_ID=28
YOUTUBE_MADE_FOR_KIDS=0

