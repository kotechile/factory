# Supabase (Auth + DB) — never commit real values; set these in Coolify/runtime env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Payments + Webhooks)
# STRIPE_MODE selects which key pair the server sends: "test" = sandbox, "live" = production.
# The mode is decided by the KEY, never by the Stripe dashboard toggle — which is why both
# pairs stay configured and switching is a single env change (see src/lib/stripe/mode.ts).
# Keep BOTH pairs on the production app; set only the sandbox pair on a dev box.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
# Legacy single-slot names — superseded by the mode pairs above. Still read as a fallback when
# the mode-specific slot is empty (the secret key must still match STRIPE_MODE's prefix).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend (Transactional Email)
RESEND_API_KEY=

# Internal Editorial Gate (Access to editorial-factory.aichieve.net & /pressflow)
EDITORIAL_SECRET=factory_editorial_2026

# Public App Base URL
NEXT_PUBLIC_APP_URL=https://apps.giniloh.com

